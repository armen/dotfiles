#!/usr/bin/env bash
#
# setup-env - idempotent setup of my preferred Debian-based GNOME environment.
# Safe to run multiple times.
#
#   ./setup-env user@host   # copy this script to the machine and run it there
#   ./setup-env             # run the setup locally on the current machine
#
# When given a remote target it copies itself over and runs with `ssh -t`, so
# sudo has a real terminal to prompt for a password on. GNOME desktop settings
# (profile, shortcuts, extensions) take effect after the next login.
#
set -euo pipefail

PAPERWM_UUID="paperwm@paperwm.github.com"
PAPERWM_OK=1   # cleared by preflight if the GNOME version is unsupported
PROFILE_UUID="0d6a812d-be5a-470c-ab15-df3993db2010"   # fixed gnome-terminal 'armen' profile id
REGDOMAIN="AU"   # WiFi country; regdom '00' (default) disables 5 GHz ch149-165 and 2.4 GHz ch12-13

##### What gets set up (read top to bottom) #################################

main() {
    case "${1:-}" in
        -h|--help)       usage; exit 0 ;;
        -*)              echo "Unknown option: $1" >&2; exit 1 ;;
        ?*)              deploy "$1"; exit 0 ;;         # a user@host was given
    esac

    preflight          # verify assumptions, acquire sudo, find the D-Bus session
    set_regdomain      # WiFi country (offline-safe; unblocks 5 GHz so apt can reach the net)
    install_packages   # apt: zsh, vim, tmux, gnome-tweaks, ...
    install_glow       # glow markdown renderer (Charm apt repo)
    set_login_shell    # make zsh the login shell (best-effort)
    install_ohmyzsh    # oh-my-zsh
    install_dotfiles   # armen/dotfiles -> vim, tmux, zsh theme, PATH, crontab
    configure_git      # global git configs
    install_paperwm    # PaperWM GNOME extension (files)

    # GNOME settings - preflight guaranteed the session bus is present.
    enable_paperwm     # turn the extension on for next login (merges the ext list)
    gnome_settings     # terminal profile, shortcuts, keyboard, privacy (one dconf load)

    say "Done. Log out and back in for the shell, PaperWM and shortcuts to take effect."
}

##### Steps #################################################################

preflight() {
    say "Checking assumptions"
    [ "$(id -u)" -ne 0 ] || { echo "Run as your normal user, not root." >&2; exit 1; }
    command -v apt-get     >/dev/null || { echo "This script targets Debian-based systems (apt-get missing)." >&2; exit 1; }
    command -v sudo        >/dev/null || { echo "sudo is required." >&2; exit 1; }
    command -v gnome-shell >/dev/null || warn "gnome-shell not found - assuming GNOME is installed."

    if command -v gnome-shell >/dev/null; then
        local gver
        gver=$(gnome-shell --version 2>/dev/null | grep -oE '[0-9]+' | head -1 || true)
        if [ -n "${gver:-}" ] && { [ "$gver" -lt 45 ] || [ "$gver" -gt 50 ]; }; then
            PAPERWM_OK=0
            warn "GNOME Shell $gver is outside PaperWM's supported range (45–50); skipping PaperWM."
        fi
    fi

    # Acquire sudo up front so the password is asked once, early, on a real TTY.
    if ! sudo -n true 2>/dev/null; then
        echo "Administrator (sudo) access is required - you may be prompted for your password."
        sudo -v || { echo "Could not obtain sudo access. Re-run with a terminal, e.g. 'ssh -t host bash /tmp/setup-env'." >&2; exit 1; }
    fi

    # The GNOME settings need a D-Bus session bus. On systemd it is present over
    # SSH (the per-user bus) even before a GNOME login; prefer an exported address,
    # otherwise fall back to the user bus socket.
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$(id -u)/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    fi
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        echo "No D-Bus session bus - cannot apply GNOME settings. Re-run once logged in (or over SSH, which provides a user bus)." >&2
        exit 1
    fi
}

# Set the WiFi regulatory domain.
set_regdomain() {
    say "Setting WiFi regulatory domain ($REGDOMAIN)"
    local conf=/etc/modprobe.d/cfg80211.conf line
    line="options cfg80211 ieee80211_regdom=$REGDOMAIN"
    if [ "$(cat "$conf" 2>/dev/null)" != "$line" ]; then
        echo "$line" | sudo tee "$conf" >/dev/null
        warn "Regulatory domain written to $conf; a reboot applies it to the WiFi driver."
    fi
    command -v iw >/dev/null && sudo iw reg set "$REGDOMAIN" 2>/dev/null || true
}

install_packages() {
    say "Installing packages"
    export DEBIAN_FRONTEND=noninteractive
    sudo apt-get update -qq
    sudo apt-get install -y -qq \
        git tig curl ca-certificates \
        zsh vim tmux cron xinput parallel pv \
        iw wireless-regdb \
        uuid-runtime dconf-cli libglib2.0-bin \
        gnome-terminal gnome-tweaks gnome-shell-extensions
}

install_glow() {
    say "Installing glow"
    command -v glow >/dev/null && { echo "glow already installed"; return 0; }
    # Install it directly, if found.
    if apt-cache policy glow 2>/dev/null | grep -q 'Candidate: [^(]'; then
        sudo apt-get install -y -qq glow || warn "glow install failed; skipping."
        return 0
    fi
    # no distro package: pull glow from Charm's own apt repo.
    local key=/etc/apt/keyrings/charm.gpg list=/etc/apt/sources.list.d/charm.list
    if [ ! -f "$list" ]; then
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o "$key" \
            || { warn "Could not fetch Charm apt key; skipping glow."; return 0; }
        echo "deb [signed-by=$key] https://repo.charm.sh/apt/ * *" | sudo tee "$list" >/dev/null
    fi
    sudo apt-get update -qq
    sudo apt-get install -y -qq glow || warn "glow install failed; skipping."
}

set_login_shell() {
    say "Setting zsh as the login shell"
    local me zsh_path
    me=$(id -un)
    zsh_path=$(command -v zsh)
    if ! grep -q "^$me:" /etc/passwd 2>/dev/null; then
        warn "User '$me' is not a local account (e.g. LDAP/SSSD) - cannot chsh. Set your login shell to $zsh_path via your directory service, or add 'exec $zsh_path -l' to ~/.bashrc."
    elif [ "$(getent passwd "$me" | cut -d: -f7)" != "$zsh_path" ]; then
        sudo chsh -s "$zsh_path" "$me" || warn "chsh failed - change your login shell to $zsh_path manually."
    fi
}

install_ohmyzsh() {
    say "Installing oh-my-zsh"
    if [ ! -d "$HOME/.oh-my-zsh" ]; then
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
            "" --unattended --keep-zshrc
    fi
}

install_dotfiles() {
    say "Installing dotfiles (github.com/armen/dotfiles)"
    local tmp target
    if [ ! -d "$HOME/.dotfiles" ]; then
        # First run: the installer clones ~/.dotfiles and creates the vim/tmux symlinks.
        tmp=$(mktemp)
        curl -fsSL https://raw.githubusercontent.com/armen/dotfiles/master/install.bash -o "$tmp"
        bash "$tmp" </dev/null || warn "dotfiles install.bash returned non-zero (usually harmless)."
        rm -f "$tmp"
    else
        # Subsequent runs: pull and update vim plugins.
        bash "$HOME/.dotfiles/install.bash" </dev/null || warn "dotfiles install.bash returned non-zero (usually harmless)."
    fi

    # Fail loudly if the installer did not produce the expected files (it may exit
    # non-zero merely because it sources ~/.zshrc at the end).
    # The armen zsh theme, PATH and crontab are configured by install.bash itself.
    for target in "$HOME/.dotfiles" "$HOME/.vimrc" "$HOME/.tmux.conf"; do
        [ -e "$target" ] || { echo "dotfiles setup incomplete - $target is missing. Aborting." >&2; exit 1; }
    done
}

configure_git() {
    say "Configuring git identity"
    git config --global user.name  "Armen Baghumian"
    git config --global user.email "armen@opensourceclub.org"
    git config --global core.editor "vim"
}

install_paperwm() {
    say "Installing PaperWM"
    local dir="$HOME/.local/share/gnome-shell/extensions/$PAPERWM_UUID"
    if [ "$PAPERWM_OK" != 1 ]; then
        warn "Skipping PaperWM install (unsupported GNOME version)."
        return 0
    fi
    [ -d "$dir" ] || git clone -b release https://github.com/paperwm/PaperWM.git "$dir"
    [ -d "$dir/schemas" ] && glib-compile-schemas "$dir/schemas"
}

##### GNOME settings (each writes gsettings/dconf; need the session bus) #####

enable_paperwm() {
    [ "${PAPERWM_OK:-1}" = 1 ] || return 0
    say "Enabling PaperWM"
    gsettings_add    org.gnome.shell enabled-extensions  "$PAPERWM_UUID"
    gsettings_remove org.gnome.shell disabled-extensions "$PAPERWM_UUID"
    gnome-extensions enable "$PAPERWM_UUID" 2>/dev/null || true

    local PW="/org/gnome/shell/extensions/paperwm"
    dconf write "$PW/window-gap"        5  # Gap between windows
    dconf write "$PW/horizontal-margin" 0  # Horizontal margin
    dconf write "$PW/vertical-margin"   0  # Top margin
}

# All static GNOME settings in one declarative dconf load. The heredoc is
# unquoted so $HOME and $PROFILE_UUID expand.
gnome_settings() {
    say "GNOME settings (terminal, shortcuts, keyboard, privacy)"
    dconf load / <<EOF
[org/gnome/desktop/input-sources]
xkb-options=['caps:ctrl_modifier']

[org/gnome/desktop/wm/keybindings]
# unbind Activate-window-menu (Alt+Space) and Hide (Super+H)
activate-window-menu=@as []
minimize=@as []

[desktop/ibus/panel/emoji]
# disable the Super+. emoji picker cause conflicting with PaperWM
hotkey=@as []

[org/gnome/desktop/session]
# never blank the screen
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/terminal/legacy/profiles:]
list=['$PROFILE_UUID']
default='$PROFILE_UUID'

[org/gnome/terminal/legacy/profiles:/:$PROFILE_UUID]
visible-name='armen'
use-theme-colors=false
use-system-font=false
font='Monospace 11'
foreground-color='rgb(131,148,150)'
background-color='rgb(0,43,54)'
scrollbar-policy='never'
# Solarized Dark, with one deviation: slot 8 (bright black) is base01 rgb(88,110,117) instead of stock base03 rgb(0,43,54).
# Stock Solarized puts the background colour in slot 8, so any tool that uses bright black as a "dim" colour (\e[1;90m or \e[90m)
# writes invisible text. base01 keeps it dim but legible.
palette=['rgb(7,54,66)', 'rgb(220,50,47)', 'rgb(133,153,0)', 'rgb(181,137,0)', 'rgb(38,139,210)', 'rgb(211,54,130)', 'rgb(42,161,152)', 'rgb(238,232,213)', 'rgb(88,110,117)', 'rgb(203,75,22)', 'rgb(88,110,117)', 'rgb(101,123,131)', 'rgb(131,148,150)', 'rgb(108,113,196)', 'rgb(147,161,161)', 'rgb(253,246,227)']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ws-shell/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ws-scroll/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ws-shell]
name='Shell'
binding='<Shift><Super>Return'
command="/bin/zsh -c \"gnome-terminal --full-screen -- /bin/zsh -c 'tmux attach || tmux'\""

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ws-scroll]
name='Toggle Middle Scroll'
binding='<Super>Menu'
command='$HOME/.dotfiles/bin/scroll-toggle'
EOF
}

##### Utilities #############################################################

say()  { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
setup-env - idempotent setup of my preferred Debian-based GNOME environment.

  ./setup-env user@host   copy this script to the machine and run it there
  ./setup-env             run the setup locally on the current machine
EOF
}

# Copy this script to a remote host and run it there over an SSH pseudo-terminal
# (so sudo can prompt for a password).
deploy() {
    local target=$1 self remote
    self=${BASH_SOURCE[0]}
    [ -f "$self" ] || { echo "Run this as a file (not piped) to deploy to a remote host." >&2; exit 1; }
    command -v scp >/dev/null && command -v ssh >/dev/null || { echo "scp and ssh are required." >&2; exit 1; }
    remote=$(ssh "$target" 'mktemp -t setup-env.XXXXXX') || { echo "Could not create a temp file on $target." >&2; exit 1; }
    say "Copying $self to $target:$remote"
    scp -q "$self" "$target:$remote"
    say "Running setup-env on $target"
    ssh -t "$target" "bash $remote; rc=\$?; rm -f $remote; exit \$rc"
}

# Print the elements of a GVariant "as" (array of strings) literal, one per line.
_gv_items() {
    local cur=$1 it
    cur=${cur#@as }; cur=${cur#[}; cur=${cur%]}
    [ -n "$cur" ] || return 0
    local IFS=,
    for it in $cur; do
        it=${it# }; it=${it#\'}; it=${it%\'}
        printf '%s\n' "$it"
    done
}

# Add an element to a GVariant "as" gsettings key, keeping existing entries.
# No-op if already present.
gsettings_add() {
    local schema=$1 key=$2 value=$3 cur
    cur=$(gsettings get "$schema" "$key" 2>/dev/null || echo "@as []")
    case "$cur" in
        *"'$value'"*) return 0 ;;
    esac
    if [ "$cur" = "@as []" ] || [ "$cur" = "[]" ]; then
        gsettings set "$schema" "$key" "['$value']"
    else
        gsettings set "$schema" "$key" "${cur%]}, '$value']"
    fi
}

# Remove an element from a GVariant "as" gsettings key. No-op if absent.
gsettings_remove() {
    local schema=$1 key=$2 value=$3 cur it new=""
    cur=$(gsettings get "$schema" "$key" 2>/dev/null || echo "@as []")
    case "$cur" in *"'$value'"*) ;; *) return 0 ;; esac
    while IFS= read -r it; do
        [ "$it" = "$value" ] && continue
        new="$new, '$it'"
    done < <(_gv_items "$cur")
    gsettings set "$schema" "$key" "[${new#, }]"
}

main "$@"
